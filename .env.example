# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 可选：本地 v4 数据目录（默认 data/v4-ready）
# ZIWEI_V4_DIR=/absolute/path/to/v4-ready

# 复制为 .env.local 后按需配置；默认关闭 AI。
# AI_ENABLED=true
# MODEL_BASE_URL=https://provider.example/v1
# MODEL_API_KEY=
# MODEL_DEFAULT=gpt-6.1-terra
# AI_DAILY_LIMIT=1
# AI_QUOTA_FILE=/absolute/writable/path/ai-quota.json
# AI_TIMEOUT_MS=30000
# AI_MAX_OUTPUT_TOKENS=1200
# 限额按 UTC 日期计算，最大 50；文件仅支持单 Node 进程使用。
